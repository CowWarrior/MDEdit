<Window x:Class="MDEdit.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preferences"
        Icon="Resources/AppIcon.ico"
        Width="760" Height="660"
        MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!-- Every change applies live (Requirements.md §6) — there's no separate Apply step; Cancel
         reverts a snapshot taken when this window opened.

         One tab per editor mode, because WYSIWYG and source mode carry fully independent styling:
         the same document is rendered for different purposes, so a heading may be large and
         proportional in one and plain mono in the other. Both tabs' contents are built by a single
         ModeStyleEditor instance each — see PreferencesWindow.xaml.cs. -->
    <DockPanel Margin="16">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Reset to Default" Click="BtnResetToDefault_Click" Padding="8,4" Margin="0,0,24,0"/>
            <Button Content="OK" IsDefault="True" Click="BtnOk_Click" Width="80" Padding="4" Margin="0,0,8,0"/>
            <Button Content="Cancel" IsCancel="True" Click="BtnCancel_Click" Width="80" Padding="4"/>
        </StackPanel>

        <TabControl>
            <TabItem Header="WYSIWYG">
                <ContentControl x:Name="WysiwygTabHost" Margin="12"/>
            </TabItem>
            <TabItem Header="Source">
                <ContentControl x:Name="SourceTabHost" Margin="12"/>
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
