<Window x:Class="MDEdit.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preferences"
        Icon="Resources/AppIcon.ico"
        Width="520" Height="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel Margin="16">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Fonts" FontWeight="Bold" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="WYSIWYG font:" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="WysiwygFontCombo" SelectionChanged="WysiwygFontCombo_SelectionChanged"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Code font:" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="CodeFontCombo" SelectionChanged="CodeFontCombo_SelectionChanged"/>
            </Grid>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Reset to Default" Click="BtnResetToDefault_Click" Padding="8,4" Margin="0,0,24,0"/>
            <Button Content="OK" IsDefault="True" Click="BtnOk_Click" Width="80" Padding="4" Margin="0,0,8,0"/>
            <Button Content="Cancel" IsCancel="True" Click="BtnCancel_Click" Width="80" Padding="4"/>
        </StackPanel>

        <!-- Every change applies live (Requirements.md §6) — there's no separate Apply step;
             Cancel reverts a snapshot taken when this window opened. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Colors" FontWeight="Bold" Margin="0,0,0,6"/>
                <!-- Rows are built in code-behind, one per customizable construct — see
                     PreferencesWindow.xaml.cs's ColorRows. -->
                <Grid x:Name="ColorGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
