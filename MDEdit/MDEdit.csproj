<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <!-- Application.ThemeMode (Fluent themes) is still marked experimental; used deliberately for dark mode. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MDEdit.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Markdown.xshd" />
  </ItemGroup>

  <!-- WPF "Resource" build action, distinct from the EmbeddedResource above, so XAML can reference these via a relative pack URI.
       AppIcon.png is used instead of the .ico in the About dialog: WPF's Image control renders a multi-res .ico
       from its smallest embedded frame and upscales it, which looks blurry at anything above ~32px. -->
  <ItemGroup>
    <Resource Include="Resources\AppIcon.ico" />
    <Resource Include="Resources\AppIcon.png" />
  </ItemGroup>

  <!-- Sample documents shipped alongside the app. Content (not Resource/EmbeddedResource) so they stay
       ordinary files on disk the user can open, and so ClickOnce carries them in the deployment payload.
       Welcome.md's "Recent changes" section is the user-facing changelog — update it before every publish. -->
  <ItemGroup>
    <Content Include="samples\**\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Deterministic builds strip the PE timestamp, so stamp the build time into assembly metadata instead (read by the About dialog). -->
  <ItemGroup>
    <AssemblyMetadata Include="BuildDate" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd HH:mm')) UTC" />
  </ItemGroup>

  <!-- Same <Major.Minor.Build>.<commit count> scheme build/Publish-ClickOnce.ps1 uses for
       ApplicationVersion, so the assembly version shown in the About dialog matches the deployed
       ClickOnce version. Major.Minor.Build comes from build/published-version.txt (the LAST published
       release), the revision from git — so a local build at the publish commit reports exactly the
       published version, and afterwards differs only in the revision, which is the honest answer.
       Both parts degrade to the SDK default rather than failing the build if unavailable. -->
  <Target Name="SetVersionFromGit" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo">
    <Exec Command="git rev-list --count HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="WarnAndContinue">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommitCount" />
    </Exec>
    <PropertyGroup>
      <_PublishedVersionFile>$(MSBuildThisFileDirectory)..\build\published-version.txt</_PublishedVersionFile>
    </PropertyGroup>
    <!-- Publish-ClickOnce.ps1 passes MDEditReleaseVersion for the release being published. It must,
         because published-version.txt records the release LAST published and is only written back
         after a successful publish — so during a publish it still holds the previous value, and
         reading it there stamped the assembly one release behind the deployment manifest. Ordinary
         builds pass nothing and fall back to the file, which is correct for them. -->
    <PropertyGroup Condition="'$(MDEditReleaseVersion)' == '' and Exists('$(_PublishedVersionFile)')">
      <_PublishedVersionRaw>$([System.IO.File]::ReadAllText('$(_PublishedVersionFile)'))</_PublishedVersionRaw>
      <MDEditReleaseVersion>$(_PublishedVersionRaw.Trim())</MDEditReleaseVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(_GitCommitCount)' != '' and '$(MDEditReleaseVersion)' != ''">
      <Version>$(MDEditReleaseVersion).$(_GitCommitCount)</Version>
    </PropertyGroup>
  </Target>

  <!-- Authenticode-sign Release builds with the local code-signing cert (CN=Maze Code Signing). -->
  <Target Name="SignAssembly" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(OS)' == 'Windows_NT'">
    <!-- Sign the managed assembly and, since UseAppHost defaults to true for WinExe, the native .exe launcher users actually run. -->
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\build\Sign.ps1&quot; -FilePath &quot;$(TargetPath)&quot;" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\build\Sign.ps1&quot; -FilePath &quot;$(TargetDir)$(TargetName).exe&quot;"
          Condition="Exists('$(TargetDir)$(TargetName).exe')" />
  </Target>

</Project>
