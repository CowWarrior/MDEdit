<?xml version="1.0"?>
<SyntaxDefinition name="Markdown" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">

  <!-- These carry NO visual attributes on purpose. Every colour, weight, style, decoration, family
       and size is written onto them at load time by Editing/MarkdownHighlighting.Build, from
       AppSettings.EditorPreferences (Requirements.md §6) — once per editor mode and theme, giving
       four compiled definitions.

       Baking values here as a fallback would break "inherit": Build clears each property before
       applying the user's style, so anything left in this file would either be dead weight or, if
       the clearing were removed, would silently resurface for an element the user had explicitly
       cleared. The defaults of record therefore live in EditorPreferences, in exactly one place —
       see ModeStyles.SourceDefaults/WysiwygDefaults, pinned by EditorPreferencesTests.

       The names below are still load-bearing: the rules further down reference them, and
       StyledElements maps each to the element key whose style fills it in. -->
  <Color name="Bold" />
  <Color name="Italic" />
  <Color name="BoldItalic" />
  <Color name="Strike" />
  <Color name="Highlight" />
  <Color name="Underline" />
  <Color name="InlineCode" />
  <Color name="CodeBlock" />
  <Color name="Link" />
  <Color name="ListMarker" />
  <Color name="Comment" />

  <RuleSet>

    <!-- Fenced code blocks: plain delimiters, no wildcard quantifiers -->
    <Span color="CodeBlock" multiline="true">
      <Begin>^```</Begin>
      <End>^```</End>
      <RuleSet/>
    </Span>
    <Span color="CodeBlock" multiline="true">
      <Begin>^~~~</Begin>
      <End>^~~~</End>
      <RuleSet/>
    </Span>

    <!-- HTML comments -->
    <Span color="Comment" multiline="true">
      <Begin>&lt;!--</Begin>
      <End>--&gt;</End>
    </Span>

    <!-- List markers: min 2 chars, no * quantifier -->
    <Rule color="ListMarker">[-\*\+]\s</Rule>
    <Rule color="ListMarker">\d+\.\s</Rule>

    <!-- Bold+Italic (must precede Bold and Italic) -->
    <Rule color="BoldItalic">\*{3}[^\*\n]+\*{3}</Rule>
    <Rule color="BoldItalic">_{3}[^_\n]+_{3}</Rule>

    <!-- Bold, each with a nested Rule recognizing italic wrapped in the OTHER delimiter
         character (e.g. "**_text_**") — CommonMark forbids nesting the same delimiter inside
         itself, so mixing delimiter families is the standard, unambiguous way to combine bold
         and italic as two nested runs. The nested Rule is colored BoldItalic (not Italic)
         explicitly, since it's inside a Bold span and needs both weight and style, not a
         color override that might drop the surrounding boldness. -->
    <Span color="Bold">
      <Begin>\*{2}</Begin>
      <End>\*{2}</End>
      <RuleSet>
        <Rule color="BoldItalic">_[^_\n]+_</Rule>
      </RuleSet>
    </Span>
    <Span color="Bold">
      <Begin>_{2}</Begin>
      <End>_{2}</End>
      <RuleSet>
        <Rule color="BoldItalic">\*[^\*\n]+\*</Rule>
      </RuleSet>
    </Span>

    <!-- Italic, each with a nested Rule recognizing bold wrapped in the OTHER delimiter
         character (e.g. "_**text**_") — same reasoning as above, reversed. -->
    <Span color="Italic">
      <Begin>\*</Begin>
      <End>\*</End>
      <RuleSet>
        <Rule color="BoldItalic">_{2}[^_\n]+_{2}</Rule>
      </RuleSet>
    </Span>
    <Span color="Italic">
      <Begin>_</Begin>
      <End>_</End>
      <RuleSet>
        <Rule color="BoldItalic">\*{2}[^\*\n]+\*{2}</Rule>
      </RuleSet>
    </Span>

    <!-- Strikethrough -->
    <Rule color="Strike">~~[^~\n]+~~</Rule>

    <!-- Highlight (extended syntax) -->
    <Rule color="Highlight">={2}[^=\n]+={2}</Rule>

    <!-- Underline: literal inline HTML, not Markdown. Lowercase tag only, no attributes. -->
    <Rule color="Underline">&lt;u&gt;[^&lt;\n]+&lt;/u&gt;</Rule>

    <!-- Inline code -->
    <Rule color="InlineCode">`[^`\n]+`</Rule>

    <!-- Images (before links) -->
    <Rule color="Link">!\[[^\]\n]+\]\([^\)\n]+\)</Rule>

    <!-- Inline and reference links -->
    <Rule color="Link">\[[^\]\n]+\]\([^\)\n]+\)</Rule>
    <Rule color="Link">\[[^\]\n]+\]\[[^\]\n]+\]</Rule>

  </RuleSet>

</SyntaxDefinition>
